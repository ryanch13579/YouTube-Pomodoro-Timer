{
  "manifest_version": 3,
  "name": "Focus Tunes: YouTube Pomodoro Timer",
  "version": "1.0.0",
  "description": "Paste a YouTube link to play it as background music while a Pomodoro timer keeps you focused.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Tunes",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "offscreen",
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": ["https://www.youtube.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
